<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <UseWPF>true</UseWPF>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>FundoVivo</AssemblyName>
    <RootNamespace>FundoVivo</RootNamespace>
    <Version>2.2.0</Version>
    <Product>Fundo Vivo</Product>
    <Company>Felipe</Company>
    <ApplicationIcon>..\..\icone\icone.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <SatelliteResourceLanguages>none</SatelliteResourceLanguages>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <InvariantGlobalization>false</InvariantGlobalization>
    <TieredPGO>true</TieredPGO>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4314.35" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Engine\web-shim.js" LogicalName="web-shim.js" />
    <EmbeddedResource Include="Runtime\index.html" LogicalName="runtime/index.html" />
    <EmbeddedResource Include="Runtime\vivo.js" LogicalName="runtime/vivo.js" />
    <Resource Include="..\..\icone\icone.ico" Link="icone.ico" />
    <Resource Include="Fonts\Quicksand-Medium.ttf" />
    <Resource Include="Fonts\Quicksand-Bold.ttf" />
  </ItemGroup>
</Project>
