<Window x:Class="FundoVivo.Settings.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Fundo Vivo" Width="1320" Height="860" MinWidth="960" MinHeight="620"
        Background="{StaticResource Paper}" WindowStartupLocation="CenterScreen" Style="{StaticResource WindowText}"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display" Icon="/icone.ico">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="28,20,28,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Image Source="/icone.ico" Width="28" Height="28" Margin="0,0,12,0"/>
                <TextBlock Text="Fundo Vivo" Style="{StaticResource H1}" VerticalAlignment="Center"/>
                <Border Background="{StaticResource Well}" CornerRadius="999" Padding="10,4" Margin="16,2,0,0" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse x:Name="StatusDot" Width="8" Height="8" Fill="{StaticResource Ink3}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock x:Name="StatusText" Text="Abrindo" FontSize="12" Foreground="{StaticResource Ink2}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </StackPanel>
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                <Button x:Name="PauseAllButton" Content="Pausar tudo" Margin="0,0,12,0" Click="PauseAll_Click"/>
                <Border Style="{StaticResource SegmentBar}">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton x:Name="TabLibrary" Content="Biblioteca" Style="{StaticResource Segment}" GroupName="tabs" IsChecked="True" Checked="Tab_Checked"/>
                        <RadioButton x:Name="TabSettings" Content="Ajustes" Style="{StaticResource Segment}" GroupName="tabs" Margin="0" Checked="Tab_Checked"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>

        <!-- Monitor map, drawn to scale from the real layout -->
        <Border Grid.Row="1" Margin="28,18,28,0" Style="{StaticResource Card}" Padding="18,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Width="170" VerticalAlignment="Center">
                    <TextBlock Text="Seus monitores" Style="{StaticResource H2}" Margin="0,0,0,4"/>
                    <TextBlock Text="Clique num monitor e depois num wallpaper para colocar nele." Style="{StaticResource Muted}"/>
                </StackPanel>
                <Canvas x:Name="MonitorCanvas" Grid.Column="1" Height="150" Margin="16,0,0,0" ClipToBounds="False" SizeChanged="MonitorCanvas_SizeChanged"/>
            </Grid>
        </Border>

        <!-- Library page -->
        <Grid x:Name="LibraryPage" Grid.Row="2" Margin="28,18,28,24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="360"/>
            </Grid.ColumnDefinitions>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border Style="{StaticResource SegmentBar}">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton x:Name="FilterAll" Content="Todos" Style="{StaticResource Segment}" GroupName="filter" IsChecked="True" Checked="Filter_Changed"/>
                            <RadioButton x:Name="FilterVideo" Content="Vídeo" Style="{StaticResource Segment}" GroupName="filter" Checked="Filter_Changed"/>
                            <RadioButton x:Name="FilterWeb" Content="Web" Style="{StaticResource Segment}" GroupName="filter" Checked="Filter_Changed"/>
                            <RadioButton x:Name="FilterImage" Content="Imagem" Style="{StaticResource Segment}" GroupName="filter" Margin="0" Checked="Filter_Changed"/>
                        </StackPanel>
                    </Border>
                    <Grid Grid.Column="1" Margin="12,0" MaxWidth="360" HorizontalAlignment="Left">
                        <TextBox x:Name="SearchBox" TextChanged="Search_Changed" Padding="30,6,8,6"/>
                        <TextBlock Text="&#xE721;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="13" Foreground="{StaticResource Ink3}" Margin="11,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"/>
                        <TextBlock x:Name="SearchHint" Text="Procurar pelo nome" Foreground="{StaticResource Ink3}" Margin="31,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"/>
                    </Grid>
                    <Button Grid.Column="2" Content="Adicionar arquivo" Click="AddFile_Click"/>
                </Grid>
                <TextBlock x:Name="LibraryInfo" Grid.Row="1" Style="{StaticResource Muted}" Margin="2,10,0,10"/>
                <ScrollViewer x:Name="LibraryScroll" Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" PanningMode="VerticalOnly" SizeChanged="LibraryScroll_SizeChanged">
                    <ItemsControl x:Name="LibraryList">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>

            <!-- Selected monitor -->
            <Border Grid.Column="2" Style="{StaticResource Card}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20,18">
                    <StackPanel x:Name="SidePanel">
                        <TextBlock Text="NESTE MONITOR" Style="{StaticResource Label}" Margin="0,0,0,4"/>
                        <TextBlock x:Name="SideMonitorName" Style="{StaticResource H2}" TextWrapping="Wrap"/>
                        <Border CornerRadius="10" ClipToBounds="True" Background="{StaticResource Well}" Height="180" Margin="0,4,0,10">
                            <Grid>
                                <Image x:Name="SideThumb" Stretch="UniformToFill"/>
                                <TextBlock x:Name="SideEmpty" Text="Papel de parede do Windows" Style="{StaticResource Muted}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                        <TextBlock x:Name="SideTitle" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap"/>
                        <TextBlock x:Name="SideDetail" Style="{StaticResource Muted}" Margin="0,2,0,0"/>

                        <StackPanel x:Name="SideControls">
                            <TextBlock Text="ENCAIXE" Style="{StaticResource Label}"/>
                            <Border Style="{StaticResource SegmentBar}">
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton x:Name="FitFill" Content="Preencher" Style="{StaticResource Segment}" GroupName="fit" Checked="Fit_Checked"/>
                                    <RadioButton x:Name="FitFit" Content="Ajustar" Style="{StaticResource Segment}" GroupName="fit" Checked="Fit_Checked"/>
                                    <RadioButton x:Name="FitStretch" Content="Esticar" Style="{StaticResource Segment}" GroupName="fit" Margin="0" Checked="Fit_Checked"/>
                                </StackPanel>
                            </Border>

                            <StackPanel x:Name="SoundSection">
                                <TextBlock Text="SOM" Style="{StaticResource Label}"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="56"/>
                                    </Grid.ColumnDefinitions>
                                    <Slider x:Name="VolumeSlider" Minimum="0" Maximum="100" VerticalAlignment="Center" ValueChanged="Volume_Changed"/>
                                    <TextBlock x:Name="VolumeText" Grid.Column="1" Text="Mudo" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{StaticResource Ink2}"/>
                                </Grid>
                            </StackPanel>

                            <StackPanel x:Name="OptimizeSection">
                                <TextBlock Text="DEIXAR MAIS LEVE" Style="{StaticResource Label}"/>
                                <TextBlock x:Name="OptimizeText" Style="{StaticResource Muted}"/>
                                <ProgressBar x:Name="OptimizeProgress" Margin="0,10,0,0" Visibility="Collapsed" Maximum="1"/>
                                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                    <Button x:Name="OptimizeButton" Content="Converter para este monitor" Click="Optimize_Click"/>
                                    <Button x:Name="OptimizeCancel" Content="Cancelar" Style="{StaticResource Quiet}" Margin="6,0,0,0" Visibility="Collapsed" Click="OptimizeCancel_Click"/>
                                </StackPanel>
                            </StackPanel>

                            <StackPanel x:Name="PropertiesSection">
                                <Grid Margin="0,14,0,6">
                                    <TextBlock Text="OPÇÕES DO WALLPAPER" Style="{StaticResource Label}" Margin="0"/>
                                    <Button Content="Restaurar" Style="{StaticResource Quiet}" HorizontalAlignment="Right" Padding="6,2" Click="ResetProperties_Click"/>
                                </Grid>
                                <StackPanel x:Name="PropertiesPanel"/>
                            </StackPanel>

                            <Button x:Name="RemoveButton" Content="Voltar ao papel de parede do Windows" Margin="0,22,0,0" HorizontalAlignment="Left" Click="Remove_Click"/>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- Settings page -->
        <ScrollViewer x:Name="SettingsPage" Grid.Row="2" Margin="28,18,28,24" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
            <UniformGrid Columns="3" VerticalAlignment="Top">
                <Border Style="{StaticResource Card}" Padding="22,18" Margin="0,0,18,18" VerticalAlignment="Top">
                    <StackPanel>
                        <TextBlock Text="Quando ninguém vê o wallpaper" Style="{StaticResource H2}"/>
                        <TextBlock Text="Wallpaper escondido não precisa gastar nada. É daqui que vem a maior parte da economia." Style="{StaticResource Muted}"/>
                        <TextBlock Text="JANELA MAXIMIZADA COBRINDO O MONITOR" Style="{StaticResource Label}"/>
                        <Border Style="{StaticResource SegmentBar}">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton x:Name="CoveredPause" Content="Pausar" Style="{StaticResource Segment}" GroupName="covered" Checked="Option_Changed"/>
                                <RadioButton x:Name="CoveredKeep" Content="Continuar" Style="{StaticResource Segment}" GroupName="covered" Margin="0" Checked="Option_Changed"/>
                            </StackPanel>
                        </Border>
                        <TextBlock Text="JOGO OU PROGRAMA EM TELA CHEIA" Style="{StaticResource Label}"/>
                        <Border Style="{StaticResource SegmentBar}">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton x:Name="FullPause" Content="Pausar" Style="{StaticResource Segment}" GroupName="full" Checked="Option_Changed"/>
                                <RadioButton x:Name="FullUnload" Content="Tirar da memória" Style="{StaticResource Segment}" GroupName="full" Checked="Option_Changed"/>
                                <RadioButton x:Name="FullKeep" Content="Continuar" Style="{StaticResource Segment}" GroupName="full" Margin="0" Checked="Option_Changed"/>
                            </StackPanel>
                        </Border>
                        <TextBlock Text="Tirar da memória libera a RAM e a memória da placa de vídeo para o jogo; o wallpaper volta em menos de um segundo quando você sai." Style="{StaticResource Muted}" Margin="0,8,0,0"/>
                        <CheckBox x:Name="FullscreenAll" Content="Tela cheia num monitor pausa os outros também" Margin="0,14,0,0" Click="Option_Changed"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Padding="22,18" Margin="0,0,18,18" VerticalAlignment="Top">
                    <StackPanel>
                        <TextBlock Text="Wallpapers web" Style="{StaticResource H2}"/>
                        <CheckBox x:Name="WebMouse" Content="O mouse funciona nos wallpapers interativos" Click="Option_Changed"/>
                        <TextBlock Text="Os cliques na área de trabalho vazia chegam no wallpaper, como no Wallpaper Engine." Style="{StaticResource Muted}" Margin="44,0,0,8"/>
                        <CheckBox x:Name="WebAudio" Content="Reagir ao som que o PC está tocando" Click="Option_Changed"/>
                        <TextBlock Text="Para os visualizadores de música. Só escuta enquanto um wallpaper que pede som está na tela." Style="{StaticResource Muted}" Margin="44,0,0,0"/>

                        <TextBlock Text="Biblioteca" Style="{StaticResource H2}" Margin="0,22,0,8"/>
                        <CheckBox x:Name="ScanWe" Content="Mostrar os wallpapers do Wallpaper Engine" Click="Option_Changed"/>
                        <TextBlock x:Name="WeInfo" Style="{StaticResource Muted}" Margin="44,0,0,0"/>

                        <TextBlock Text="Início" Style="{StaticResource H2}" Margin="0,22,0,8"/>
                        <CheckBox x:Name="StartWithWindows" Content="Abrir junto com o Windows" Click="StartWithWindows_Click"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Padding="22,18" Margin="0,0,18,18" VerticalAlignment="Top">
                    <StackPanel>
                        <TextBlock Text="Atualização" Style="{StaticResource H2}"/>
                        <TextBlock x:Name="VersionText" Style="{StaticResource Muted}"/>
                        <TextBlock x:Name="UpdateText" Style="{StaticResource Muted}" Margin="0,8,0,0"/>
                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                            <Button x:Name="CheckUpdateButton" Content="Procurar atualização" Click="CheckUpdate_Click"/>
                            <Button x:Name="InstallUpdateButton" Content="Instalar" Style="{StaticResource Primary}" Margin="8,0,0,0" Visibility="Collapsed" Click="InstallUpdate_Click"/>
                        </StackPanel>
                        <TextBlock Text="TOKEN DO GITHUB (SÓ PARA REPOSITÓRIO PRIVADO)" Style="{StaticResource Label}"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <PasswordBox x:Name="TokenBox"/>
                            <Button Grid.Column="1" Content="Guardar" Margin="8,0,0,0" Click="SaveToken_Click"/>
                        </Grid>
                        <TextBlock x:Name="TokenText" Style="{StaticResource Muted}" Margin="0,6,0,0"
                                   Text="Token de leitura (fine-grained, só este repositório, Contents: leitura). Fica guardado protegido pelo Windows, fora do app."/>

                        <TextBlock Text="Programa" Style="{StaticResource H2}" Margin="0,22,0,8"/>
                        <WrapPanel>
                            <Button Content="Abrir pasta de registros" Margin="0,0,8,8" Click="OpenLogs_Click"/>
                            <Button Content="Fechar o Fundo Vivo" Margin="0,0,8,8" Click="QuitEngine_Click"/>
                        </WrapPanel>
                        <TextBlock Text="Fechar esta janela não desliga os wallpapers: eles continuam pelo ícone perto do relógio." Style="{StaticResource Muted}"/>
                    </StackPanel>
                </Border>
            </UniformGrid>
        </ScrollViewer>
    </Grid>
</Window>
