<Window x:Class="FundoVivo.Settings.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:FundoVivo.Core"
        Title="{loc:T app_name}" Width="1320" Height="860" MinWidth="960" MinHeight="620"
        Background="{DynamicResource Paper}" WindowStartupLocation="CenterScreen" Style="{StaticResource WindowText}"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display" Icon="/icone.ico">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="28,20,28,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Image Source="/icone.ico" Width="28" Height="28" Margin="0,0,12,0"/>
                <TextBlock Text="{loc:T app_name}" Style="{StaticResource H1}" VerticalAlignment="Center"/>
                <Border Background="{DynamicResource Well}" CornerRadius="{Binding ActualHeight, RelativeSource={RelativeSource Self}, Converter={StaticResource Pill}}" Padding="10,4" Margin="16,2,0,0" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse x:Name="StatusDot" Width="8" Height="8" Fill="{DynamicResource Ink3}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock x:Name="StatusText" Text="{loc:T settings_state_opening}" FontSize="12" Foreground="{DynamicResource Ink2}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </StackPanel>
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                <Button x:Name="PauseAllButton" Content="{loc:T settings_pause_all}" Margin="0,0,12,0" Click="PauseAll_Click"/>
                <Border Style="{StaticResource SegmentBar}">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton x:Name="TabLibrary" Content="{loc:T settings_tab_library}" Style="{StaticResource Segment}" GroupName="tabs" IsChecked="True" Checked="Tab_Checked"/>
                        <RadioButton x:Name="TabSettings" Content="{loc:T settings_tab_settings}" Style="{StaticResource Segment}" GroupName="tabs" Margin="0" Checked="Tab_Checked"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>

        <!-- The stage: the monitors drawn to scale with what each one shows, edge to edge, dark in both themes. -->
        <Border Grid.Row="1" Margin="28,20,28,0" Background="{DynamicResource Stage}" CornerRadius="26">
            <Grid Margin="28,22,28,18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Width="200" VerticalAlignment="Center">
                    <TextBlock Text="{loc:T settings_stage_title}" FontFamily="{StaticResource Brand}" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource StageInk}"/>
                    <TextBlock Text="{loc:T settings_stage_hint}" FontSize="12.5" Foreground="{DynamicResource StageInk2}" TextWrapping="Wrap" Margin="0,6,0,0"/>
                </StackPanel>
                <Canvas x:Name="MonitorCanvas" Grid.Column="1" Height="224" Margin="24,0,0,0" ClipToBounds="False" SizeChanged="MonitorCanvas_SizeChanged"/>
            </Grid>
        </Border>

        <!-- Library page -->
        <Grid x:Name="LibraryPage" Grid.Row="2" Margin="28,22,28,24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="360"/>
            </Grid.ColumnDefinitions>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border Style="{StaticResource SegmentBar}">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton x:Name="FilterAll" Content="{loc:T settings_filter_all}" Style="{StaticResource Segment}" GroupName="filter" IsChecked="True" Checked="Filter_Changed"/>
                            <RadioButton x:Name="FilterVideo" Content="{loc:T settings_type_video}" Style="{StaticResource Segment}" GroupName="filter" Checked="Filter_Changed"/>
                            <RadioButton x:Name="FilterWeb" Content="{loc:T settings_type_web}" Style="{StaticResource Segment}" GroupName="filter" Checked="Filter_Changed"/>
                            <RadioButton x:Name="FilterImage" Content="{loc:T settings_type_image}" Style="{StaticResource Segment}" GroupName="filter" Checked="Filter_Changed"/>
                            <RadioButton x:Name="FilterVivo" Content="{loc:T settings_type_vivo}" Style="{StaticResource Segment}" GroupName="filter" Checked="Filter_Changed"/>
                            <RadioButton x:Name="FilterScene" Content="{loc:T settings_type_scene}" Style="{StaticResource Segment}" GroupName="filter" Margin="0" Checked="Filter_Changed"/>
                        </StackPanel>
                    </Border>
                    <Grid Grid.Column="1" Margin="12,0" Width="300" HorizontalAlignment="Left">
                        <TextBox x:Name="SearchBox" TextChanged="Search_Changed" Padding="34,7,12,7"/>
                        <TextBlock Text="&#xE721;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="13" Foreground="{DynamicResource Ink3}" Margin="14,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"/>
                        <TextBlock x:Name="SearchHint" Text="{loc:T settings_search_hint}" Foreground="{DynamicResource Ink3}" Margin="35,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"/>
                    </Grid>
                    <Button Grid.Column="2" Content="{loc:T settings_add_file}" Click="AddFile_Click"/>
                </Grid>
                <!-- Tag chips: the Wallpaper Engine tags, the user's own and the content rating, folded behind "Tags". -->
                <ScrollViewer Grid.Row="1" Margin="0,12,0,0" MaxHeight="128" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <WrapPanel x:Name="TagFilters"/>
                </ScrollViewer>
                <StackPanel Grid.Row="2" Margin="2,10,0,10">
                    <TextBlock x:Name="LibraryInfo" Style="{StaticResource Muted}"/>
                    <!-- Scene conversion running in its own process: progress, queue and cancel. -->
                    <Border x:Name="SceneJobBar" Style="{StaticResource Card}" Padding="14,10" Margin="0,10,0,0" Visibility="Collapsed">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock x:Name="SceneJobText" TextTrimming="CharacterEllipsis"/>
                                <ProgressBar x:Name="SceneJobProgress" Maximum="1" Margin="0,8,0,0"/>
                            </StackPanel>
                            <Button x:Name="SceneJobButton" Grid.Column="1" Content="{loc:T settings_cancel}" Style="{StaticResource Quiet}" Margin="12,0,0,0" VerticalAlignment="Center" Click="SceneJob_Click"/>
                        </Grid>
                    </Border>
                </StackPanel>
                <ScrollViewer x:Name="LibraryScroll" Grid.Row="3" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" PanningMode="VerticalOnly" SizeChanged="LibraryScroll_SizeChanged">
                    <ItemsControl x:Name="LibraryList">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>

            <!-- Selected monitor -->
            <Border Grid.Column="2" Style="{StaticResource Card}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20,18">
                    <StackPanel x:Name="SidePanel">
                        <TextBlock Text="{loc:T settings_side_this_monitor}" Style="{StaticResource Label}" Margin="0,0,0,4"/>
                        <TextBlock x:Name="SideMonitorName" Style="{StaticResource H2}" TextWrapping="Wrap"/>
                        <Border CornerRadius="16" Background="{DynamicResource Well}" Height="180" Margin="0,6,0,12">
                            <Grid x:Name="SideThumbHost" SizeChanged="SideThumbHost_SizeChanged">
                                <Image x:Name="SideThumb" Stretch="UniformToFill"/>
                                <TextBlock x:Name="SideEmpty" Text="{loc:T settings_windows_wallpaper}" Style="{StaticResource Muted}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                        <TextBlock x:Name="SideTitle" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap"/>
                        <TextBlock x:Name="SideDetail" Style="{StaticResource Muted}" Margin="0,2,0,0"/>
                        <TextBlock x:Name="SideFps" Style="{StaticResource Muted}" Margin="0,2,0,0"/>

                        <StackPanel x:Name="SideControls">
                            <TextBlock Text="{loc:T settings_fit_label}" Style="{StaticResource Label}"/>
                            <Border Style="{StaticResource SegmentBar}">
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton x:Name="FitFill" Content="{loc:T settings_fit_fill}" Style="{StaticResource Segment}" GroupName="fit" Checked="Fit_Checked"/>
                                    <RadioButton x:Name="FitFit" Content="{loc:T settings_fit_fit}" Style="{StaticResource Segment}" GroupName="fit" Checked="Fit_Checked"/>
                                    <RadioButton x:Name="FitStretch" Content="{loc:T settings_fit_stretch}" Style="{StaticResource Segment}" GroupName="fit" Margin="0" Checked="Fit_Checked"/>
                                </StackPanel>
                            </Border>

                            <StackPanel x:Name="SoundSection">
                                <TextBlock Text="{loc:T settings_sound_label}" Style="{StaticResource Label}"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="56"/>
                                    </Grid.ColumnDefinitions>
                                    <Slider x:Name="VolumeSlider" Minimum="0" Maximum="100" VerticalAlignment="Center" ValueChanged="Volume_Changed"/>
                                    <TextBlock x:Name="VolumeText" Grid.Column="1" Text="{loc:T settings_volume_mute}" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{DynamicResource Ink2}"/>
                                </Grid>
                            </StackPanel>

                            <StackPanel x:Name="OptimizeSection">
                                <TextBlock Text="{loc:T settings_optimize_label}" Style="{StaticResource Label}"/>
                                <TextBlock x:Name="OptimizeText" Style="{StaticResource Muted}"/>
                                <ProgressBar x:Name="OptimizeProgress" Margin="0,10,0,0" Visibility="Collapsed" Maximum="1"/>
                                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                    <Button x:Name="OptimizeButton" Content="{loc:T settings_optimize_convert}" Click="Optimize_Click"/>
                                    <Button x:Name="OptimizeCancel" Content="{loc:T settings_cancel}" Style="{StaticResource Quiet}" Margin="6,0,0,0" Visibility="Collapsed" Click="OptimizeCancel_Click"/>
                                </StackPanel>
                            </StackPanel>

                            <StackPanel x:Name="PropertiesSection">
                                <Grid Margin="0,14,0,6">
                                    <TextBlock Text="{loc:T settings_properties_label}" Style="{StaticResource Label}" Margin="0"/>
                                    <Button Content="{loc:T settings_properties_reset}" Style="{StaticResource Quiet}" HorizontalAlignment="Right" Padding="6,2" Click="ResetProperties_Click"/>
                                </Grid>
                                <StackPanel x:Name="PropertiesPanel"/>
                            </StackPanel>

                            <!-- Playlist: the monitor goes through these on its own. -->
                            <StackPanel x:Name="PlaylistSection">
                                <Grid Margin="0,18,0,6">
                                    <TextBlock Text="{loc:T settings_playlist_label}" Style="{StaticResource Label}" Margin="0"/>
                                    <Button x:Name="PlaylistNext" Content="{loc:T settings_playlist_next}" Style="{StaticResource Quiet}" HorizontalAlignment="Right" Padding="8,2" Click="PlaylistNext_Click"/>
                                </Grid>
                                <TextBlock x:Name="PlaylistHint" Style="{StaticResource Muted}"/>
                                <StackPanel x:Name="PlaylistEntries" Margin="0,6,0,0"/>
                                <StackPanel x:Name="PlaylistOptions">
                                    <CheckBox x:Name="PlaylistOn" Content="{loc:T settings_playlist_auto}" Margin="0,10,0,0" Click="Playlist_Changed"/>
                                    <Border Style="{StaticResource SegmentBar}" Margin="0,8,0,0">
                                        <StackPanel x:Name="PlaylistMinutes" Orientation="Horizontal"/>
                                    </Border>
                                    <Border Style="{StaticResource SegmentBar}" Margin="0,8,0,0">
                                        <StackPanel Orientation="Horizontal">
                                            <RadioButton x:Name="PlaylistInOrder" Content="{loc:T settings_playlist_inorder}" Style="{StaticResource Segment}" GroupName="plorder" Checked="Playlist_Changed"/>
                                            <RadioButton x:Name="PlaylistShuffle" Content="{loc:T settings_playlist_shuffle}" Style="{StaticResource Segment}" GroupName="plorder" Margin="0" Checked="Playlist_Changed"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                                <Button x:Name="PlaylistAddCurrent" Content="{loc:T settings_playlist_add_current}" Margin="0,10,0,0" HorizontalAlignment="Left" Click="PlaylistAddCurrent_Click"/>
                            </StackPanel>

                            <Button x:Name="RemoveButton" Content="{loc:T settings_remove_wallpaper}" Margin="0,22,0,0" HorizontalAlignment="Left" Click="Remove_Click"/>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- Settings page -->
        <ScrollViewer x:Name="SettingsPage" Grid.Row="2" Margin="28,22,28,24" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
            <UniformGrid Columns="3" VerticalAlignment="Top">
                <Border Style="{StaticResource Card}" Padding="22,18" Margin="0,0,18,18" VerticalAlignment="Top">
                    <StackPanel>
                        <TextBlock Text="{loc:T settings_quiet_title}" Style="{StaticResource H2}"/>
                        <TextBlock Text="{loc:T settings_quiet_hint}" Style="{StaticResource Muted}"/>
                        <TextBlock Text="{loc:T settings_covered_label}" Style="{StaticResource Label}"/>
                        <Border Style="{StaticResource SegmentBar}">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton x:Name="CoveredPause" Content="{loc:T settings_pause}" Style="{StaticResource Segment}" GroupName="covered" Checked="Option_Changed"/>
                                <RadioButton x:Name="CoveredKeep" Content="{loc:T settings_keep_playing}" Style="{StaticResource Segment}" GroupName="covered" Margin="0" Checked="Option_Changed"/>
                            </StackPanel>
                        </Border>
                        <TextBlock Text="{loc:T settings_fullscreen_label}" Style="{StaticResource Label}"/>
                        <Border Style="{StaticResource SegmentBar}">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton x:Name="FullPause" Content="{loc:T settings_pause}" Style="{StaticResource Segment}" GroupName="full" Checked="Option_Changed"/>
                                <RadioButton x:Name="FullUnload" Content="{loc:T settings_unload}" Style="{StaticResource Segment}" GroupName="full" Checked="Option_Changed"/>
                                <RadioButton x:Name="FullKeep" Content="{loc:T settings_keep_playing}" Style="{StaticResource Segment}" GroupName="full" Margin="0" Checked="Option_Changed"/>
                            </StackPanel>
                        </Border>
                        <TextBlock Text="{loc:T settings_unload_hint}" Style="{StaticResource Muted}" Margin="0,8,0,0"/>
                        <CheckBox x:Name="FullscreenAll" Content="{loc:T settings_fullscreen_all}" Margin="0,14,0,0" Click="Option_Changed"/>

                        <TextBlock Text="{loc:T settings_programs_label}" Style="{StaticResource Label}" Margin="0,20,0,6"/>
                        <TextBlock Text="{loc:T settings_programs_hint}" Style="{StaticResource Muted}"/>
                        <StackPanel x:Name="ProgramRulesList" Margin="0,8,0,0"/>
                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="ProgramRuleBox" KeyDown="ProgramRuleBox_KeyDown" TextChanged="ProgramRuleBox_TextChanged"/>
                            <TextBlock x:Name="ProgramRuleHint" Text="{loc:T settings_program_hint}" Foreground="{DynamicResource Ink3}" Margin="14,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"/>
                            <Button Grid.Column="1" Content="{loc:T settings_add}" Margin="8,0,0,0" Click="AddProgramRule_Click"/>
                            <Button x:Name="PickProgramButton" Grid.Column="2" Content="{loc:T settings_from_open}" Margin="8,0,0,0" Click="PickProgram_Click"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Padding="22,18" Margin="0,0,18,18" VerticalAlignment="Top">
                    <StackPanel>
                        <TextBlock Text="{loc:T settings_web_title}" Style="{StaticResource H2}"/>
                        <CheckBox x:Name="WebMouse" Content="{loc:T settings_web_mouse}" Click="Option_Changed"/>
                        <TextBlock Text="{loc:T settings_web_mouse_hint}" Style="{StaticResource Muted}" Margin="44,0,0,8"/>
                        <CheckBox x:Name="WebAudio" Content="{loc:T settings_web_audio}" Click="Option_Changed"/>
                        <TextBlock Text="{loc:T settings_web_audio_hint}" Style="{StaticResource Muted}" Margin="44,0,0,0"/>

                        <TextBlock Text="{loc:T settings_fps_label}" Style="{StaticResource Label}" Margin="0,18,0,6"/>
                        <Border Style="{StaticResource SegmentBar}">
                            <StackPanel x:Name="FpsChoices" Orientation="Horizontal"/>
                        </Border>
                        <TextBlock Style="{StaticResource Muted}" Margin="0,8,0,0"
                                   Text="{loc:T settings_fps_hint}"/>

                        <TextBlock Text="{loc:T settings_library_title}" Style="{StaticResource H2}" Margin="0,22,0,8"/>
                        <CheckBox x:Name="ScanWe" Content="{loc:T settings_scan_we}" Click="Option_Changed"/>
                        <TextBlock x:Name="WeInfo" Style="{StaticResource Muted}" Margin="44,0,0,0"/>

                        <TextBlock Text="{loc:T settings_start_title}" Style="{StaticResource H2}" Margin="0,22,0,8"/>
                        <CheckBox x:Name="StartWithWindows" Content="{loc:T settings_start_with_windows}" Click="StartWithWindows_Click"/>

                        <TextBlock Text="{loc:T settings_appearance_title}" Style="{StaticResource H2}" Margin="0,22,0,8"/>
                        <Border Style="{StaticResource SegmentBar}">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton x:Name="ThemeSystem" Content="{loc:T settings_theme_system}" Style="{StaticResource Segment}" GroupName="theme" Checked="Theme_Checked"/>
                                <RadioButton x:Name="ThemeLight" Content="{loc:T settings_theme_light}" Style="{StaticResource Segment}" GroupName="theme" Checked="Theme_Checked"/>
                                <RadioButton x:Name="ThemeDark" Content="{loc:T settings_theme_dark}" Style="{StaticResource Segment}" GroupName="theme" Margin="0" Checked="Theme_Checked"/>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="{loc:T settings_language_title}" Style="{StaticResource H2}" Margin="0,22,0,8"/>
                        <Border Style="{StaticResource SegmentBar}">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton x:Name="LangAuto" Content="{loc:T settings_lang_auto}" Style="{StaticResource Segment}" GroupName="lang" Checked="Language_Checked"/>
                                <RadioButton x:Name="LangPt" Content="Português" Style="{StaticResource Segment}" GroupName="lang" Checked="Language_Checked"/>
                                <RadioButton x:Name="LangEn" Content="English" Style="{StaticResource Segment}" GroupName="lang" Margin="0" Checked="Language_Checked"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Padding="22,18" Margin="0,0,18,18" VerticalAlignment="Top">
                    <StackPanel>
                        <TextBlock Text="{loc:T settings_update_title}" Style="{StaticResource H2}"/>
                        <TextBlock x:Name="VersionText" Style="{StaticResource Muted}"/>
                        <TextBlock x:Name="UpdateText" Style="{StaticResource Muted}" Margin="0,8,0,0"/>
                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                            <Button x:Name="CheckUpdateButton" Content="{loc:T settings_check_update}" Click="CheckUpdate_Click"/>
                            <Button x:Name="InstallUpdateButton" Content="{loc:T settings_install}" Style="{StaticResource Primary}" Margin="8,0,0,0" Visibility="Collapsed" Click="InstallUpdate_Click"/>
                        </StackPanel>
                        <TextBlock Text="{loc:T settings_token_label}" Style="{StaticResource Label}"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <PasswordBox x:Name="TokenBox"/>
                            <Button Grid.Column="1" Content="{loc:T settings_save}" Margin="8,0,0,0" Click="SaveToken_Click"/>
                        </Grid>
                        <TextBlock x:Name="TokenText" Style="{StaticResource Muted}" Margin="0,6,0,0"
                                   Text="{loc:T settings_token_hint}"/>

                        <TextBlock Text="{loc:T settings_program_title}" Style="{StaticResource H2}" Margin="0,22,0,8"/>
                        <WrapPanel>
                            <Button Content="{loc:T settings_open_logs}" Margin="0,0,8,8" Click="OpenLogs_Click"/>
                            <Button x:Name="QuitButton" Margin="0,0,8,8" Click="QuitEngine_Click"/>
                        </WrapPanel>
                        <TextBlock Text="{loc:T settings_quit_hint}" Style="{StaticResource Muted}"/>
                    </StackPanel>
                </Border>
            </UniformGrid>
        </ScrollViewer>
    </Grid>
</Window>
