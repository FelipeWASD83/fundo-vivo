{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/FelipeWASD83/fundo-vivo/schema/vivo.schema.json",
  "title": "Fundo Vivo wallpaper (.vivo), version 1",
  "type": "object",
  "required": ["format", "version", "layers"],
  "properties": {
    "format": { "const": "fundo-vivo" },
    "version": { "const": 1 },
    "title": { "type": "string" },
    "author": { "type": "string" },
    "tags": { "type": "array", "items": { "type": "string" } },
    "loop": { "type": "number", "minimum": 1, "maximum": 120, "default": 20 },
    "background": { "$ref": "#/$defs/color", "default": "#000000" },
    "parallax": { "type": "number", "minimum": 0, "maximum": 0.15, "default": 0 },
    "preview": { "type": "string" },
    "layers": { "type": "array", "items": { "$ref": "#/$defs/layer" } },
    "effects": { "type": "array", "items": { "$ref": "#/$defs/effect" } }
  },
  "$defs": {
    "color": { "type": "string", "pattern": "^#([0-9a-fA-F]{3}|[0-9a-fA-F]{6}|[0-9a-fA-F]{8})$" },
    "anchor": { "enum": ["center", "top", "bottom", "left", "right", "top-left", "top-right", "bottom-left", "bottom-right"] },
    "animation": {
      "type": "object",
      "required": ["property", "type"],
      "properties": {
        "property": { "enum": ["x", "y", "scale", "rotation", "opacity"] },
        "type": { "enum": ["oscillate", "spin", "noise", "audio"] },
        "amount": { "type": "number" },
        "period": { "type": "number", "exclusiveMinimum": 0 },
        "phase": { "type": "number", "minimum": 0, "maximum": 1 },
        "band": { "enum": ["bass", "mid", "treble", "all"] }
      }
    },
    "layer": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": { "enum": ["image", "gradient", "shape", "particles"] },
        "name": { "type": "string" },
        "anchor": { "$ref": "#/$defs/anchor" },
        "x": { "type": "number" },
        "y": { "type": "number" },
        "opacity": { "type": "number", "minimum": 0, "maximum": 1 },
        "blend": { "enum": ["normal", "add", "screen", "multiply"] },
        "depth": { "type": "number", "minimum": 0, "maximum": 1 },
        "rotation": { "type": "number" },
        "scale": { "type": "number" },
        "animate": { "type": "array", "items": { "$ref": "#/$defs/animation" } },
        "src": { "type": "string" },
        "fit": { "enum": ["cover", "contain", "width", "height", "none"] },
        "size": { "type": "number" },
        "tint": { "$ref": "#/$defs/color" },
        "kind": { "enum": ["linear", "radial"] },
        "angle": { "type": "number" },
        "center": { "type": "array", "items": { "type": "number" }, "minItems": 2, "maxItems": 2 },
        "radius": { "type": "number" },
        "stops": {
          "type": "array", "maxItems": 8,
          "items": { "type": "array", "prefixItems": [{ "type": "number" }, { "$ref": "#/$defs/color" }], "minItems": 2, "maxItems": 2 }
        },
        "shape": { "enum": ["circle", "ring", "rect"] },
        "color": { "$ref": "#/$defs/color" },
        "height": { "type": "number" },
        "thickness": { "type": "number" },
        "softness": { "type": "number", "minimum": 0, "maximum": 1 },
        "preset": { "enum": ["rain", "snow", "dust", "fireflies"] },
        "density": { "type": "number", "minimum": 0 },
        "speed": { "type": "number", "minimum": 0 },
        "seed": { "type": "integer" }
      },
      "allOf": [
        { "if": { "properties": { "type": { "const": "image" } } }, "then": { "required": ["src"] } },
        { "if": { "properties": { "type": { "const": "gradient" } } }, "then": { "required": ["stops"] } },
        { "if": { "properties": { "type": { "const": "shape" } } }, "then": { "required": ["shape"] } },
        { "if": { "properties": { "type": { "const": "particles" } } }, "then": { "required": ["preset"] } }
      ]
    },
    "effect": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": { "enum": ["blur", "grade", "grain", "glow", "rays"] },
        "radius": { "type": "number", "minimum": 0 },
        "brightness": { "type": "number" },
        "contrast": { "type": "number" },
        "saturation": { "type": "number" },
        "hue": { "type": "number" },
        "tint": { "$ref": "#/$defs/color" },
        "tintAmount": { "type": "number", "minimum": 0, "maximum": 1 },
        "amount": { "type": "number", "minimum": 0 },
        "threshold": { "type": "number", "minimum": 0, "maximum": 1 },
        "strength": { "type": "number", "minimum": 0 },
        "anchor": { "$ref": "#/$defs/anchor" },
        "x": { "type": "number" },
        "y": { "type": "number" },
        "length": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    }
  }
}
