    { "name": "montanhas perto", "type": "image", "src": "assets/mountains-near.png", "fit": "none", "size": 0.52,
      "anchor": "bottom", "depth": 0.65 },
    { "name": "neve perto", "type": "particles", "preset": "snow", "density": 0.3, "speed": 1.1, "size": 0.009,
