      "opacity": 0.55, "depth": 0.15, "seed": 2 },
    { "name": "montanhas ao longe", "type": "image", "src": "assets/mountains-far.png", "fit": "none", "size": 0.72,
      "anchor": "bottom", "depth": 0.25 },
    { "name": "neblina", "type": "gradient", "kind": "linear", "angle": 90, "depth": 0.3,
      "stops": [[0, "#ffffff00"], [0.55, "#ffffff00"], [0.85, "#e4ecf640"], [1, "#e4ecf600"]],
