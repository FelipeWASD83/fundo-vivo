{
  "format": "fundo-vivo",
  "version": 1,
  "title": "Noite de chuva",
  "author": "Fundo Vivo",
  "tags": ["Chuva", "Noite", "Cidade"],
  "i18n": { "en": { "title": "Rainy night", "tags": ["Rain", "Night", "City"] } },
  "loop": 20,
  "background": "#0b1226",
  "parallax": 0.03,
  "preview": "preview.jpg",
  "layers": [
    { "name": "céu", "type": "gradient", "kind": "linear", "angle": 90,
      "stops": [[0, "#070b1a"], [0.55, "#17203c"], [1, "#3b2c48"]] },
    { "name": "brilho da cidade", "type": "gradient", "kind": "radial", "center": [0.5, 1.1], "radius": 1.1, "blend": "screen",
      "stops": [[0, "#ff9a5a66"], [0.6, "#a0507022"], [1, "#00000000"]],
      "animate": [{ "property": "opacity", "type": "noise", "amount": 0.12, "period": 10 }] },
    { "name": "chuva ao longe", "type": "particles", "preset": "rain", "density": 0.7, "speed": 0.75, "size": 0.0011,
      "color": "#8ea4cc", "opacity": 0.45, "depth": 0.2, "seed": 3, "angle": 8 },
    { "name": "prédios ao longe", "type": "image", "src": "assets/city-far.png", "fit": "none", "size": 0.62,
      "anchor": "bottom", "depth": 0.3, "opacity": 0.92 },
    { "name": "chuva no meio", "type": "particles", "preset": "rain", "density": 0.6, "speed": 1, "size": 0.0015,
      "color": "#aebfe0", "opacity": 0.55, "depth": 0.55, "seed": 5, "angle": 9 },
    { "name": "prédios perto", "type": "image", "src": "assets/city-near.png", "fit": "none", "size": 0.5,
      "anchor": "bottom", "depth": 0.7 },
    { "name": "chuva perto", "type": "particles", "preset": "rain", "density": 0.45, "speed": 1.3, "size": 0.0022,
      "color": "#d2ddf2", "opacity": 0.7, "depth": 1, "seed": 7, "angle": 10 }
  ],
  "effects": [
    { "type": "glow", "threshold": 0.72, "strength": 0.7, "radius": 0.01 },
    { "type": "grade", "saturation": 0.9, "contrast": 1.05, "tint": "#a8bcff", "tintAmount": 0.12 },
    { "type": "grain", "amount": 0.035 }
  ]
}
